+		if (umi_trace_console_address) {
 			umi_early_trace(0x50, (unsigned long)cur->func, umi_trace_console_address);
 		}
 #endif
 		cur->func(cur->arg);
 #if UMI_EARLY_TRACE
-		if (upto <= STARTUP_SUB_KPRINTF && umi_trace_console_address) {
+		if (umi_trace_console_address) {
 			umi_early_trace(0x51, (unsigned long)cur->func, umi_trace_console_address);
 		}
 #endif
@@ -446,12 +452,27 @@
 
 	code_signing_config_t cs_config;
 
+#if UMI_EARLY_TRACE
+	umi_early_trace(0x43, (unsigned long)version, umi_trace_console_address);
+#endif
 	printf("%s\n", version); /* log kernel version */
+#if UMI_EARLY_TRACE
+	umi_early_trace(0x44, 0, umi_trace_console_address);
+#endif
+
 
 	scale_setup();
+#if UMI_EARLY_TRACE
+	umi_early_trace(0x45, 0, umi_trace_console_address);
+#endif
+
 
 	kernel_bootstrap_log("vm_mem_bootstrap");
 	vm_mem_bootstrap();
+#if UMI_EARLY_TRACE
+	umi_early_trace(0x46, 0, umi_trace_console_address);
+#endif
+
 
 	machine_info.memory_size = (uint32_t)mem_size;
