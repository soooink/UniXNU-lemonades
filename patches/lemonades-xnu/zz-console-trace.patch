diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -3,6 +3,11 @@
  *
  *    arm platform expert initialization.
  */
+#include "../../osfmk/arm64/umi_early_trace_config.h"
+#if UMI_EARLY_TRACE
+extern void umi_early_trace(unsigned long phase, unsigned long value, unsigned long console);
+extern unsigned long umi_trace_console_address;
+#endif
 #include <sys/types.h>
 #include <sys/kdebug.h>
 #include <mach/vm_param.h>
@@ -528,17 +533,29 @@
 void
 PE_create_console(void)
 {
